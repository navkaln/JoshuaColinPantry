# Build flags (read at build time). Defaults shown.
# Small visible "Placeholder" tags + private-preview banner. Set to "false" to hide.
SHOW_PLACEHOLDER_TAGS=true
# Draft copy not yet confirmed by the board. Default off.
SHOW_UNVERIFIED=false

# Sanity (leave empty to build from the built-in default copy)
SANITY_PROJECT_ID=
SANITY_DATASET=production

---
import '@fontsource-variable/josefin-sans';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SHOW_PLACEHOLDER_TAGS } from '../lib/flags';
const { title, description } = Astro.props;
const full = title === 'Griswold Hall' ? title : `${title} · Griswold Hall`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <title>{full}</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {SHOW_PLACEHOLDER_TAGS && <div class="preview-banner" role="note">Private preview for board review. Not public.</div>}
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
